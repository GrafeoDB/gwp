{
  "name": "gwp-js",
  "version": "0.4.0",
  "description": "JavaScript/TypeScript client for the GQL Wire Protocol (GWP)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GrafeoDB/gwp.git",
